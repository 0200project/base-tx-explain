#!/bin/sh
# gh shim — refuses to WRITE to GitHub under the wrong identity.
#
# WHY: on 2026-08-29 two outreach comments were posted publicly under the
# founder's personal account instead of 0200project, on the two most valuable
# prospect threads we have. The pre-push hook already checked identity — but it
# only fires on `git push`, and `gh issue comment` is not a push. The guard
# existed on the wrong surface.
#
# DESIGN: this ALLOWLISTS reads and blocks everything else when the active
# account is wrong. Enumerating writes would miss any subcommand gh adds later,
# and "routes nobody has used yet" was an explicit requirement. Unknown command
# under a wrong identity = blocked.
#
# It never blocks `gh auth switch` or `gh auth status`, so it can never lock you
# out of fixing the very problem it reports.

REAL_GH=/opt/homebrew/bin/gh
[ -x "$REAL_GH" ] || REAL_GH=$(PATH=$(echo "$PATH" | tr ':' '\n' | grep -v gh-guard | paste -sd: -) command -v gh)
EXPECTED=0200project

# --- is this invocation a read we always permit? -----------------------------
is_read() {
  case "$1" in
    ''|--version|-v|--help|-h|help|version) return 0 ;;
    auth)
      case "$2" in status|switch|login|token) return 0 ;; *) return 1 ;; esac ;;
    api)
      # gh api defaults to GET. Any explicit method other than GET/HEAD is a write.
      for a in "$@"; do
        case "$a" in
          -X|--method) next=1 ;;
          POST|PUT|PATCH|DELETE) [ "$next" = 1 ] && return 1 ;;
          *) next=0 ;;
        esac
      done
      return 0 ;;
    browse|status|search|view|list|repo)
      case "$2" in view|list|clone) return 0 ;; *) [ "$1" = search ] || [ "$1" = browse ] || [ "$1" = status ] && return 0; return 1 ;; esac ;;
    issue|pr|release|gist|run|workflow|cache|label|secret|variable|ruleset)
      case "$2" in view|list|status|diff|checks|download) return 0 ;; *) return 1 ;; esac ;;
    *) return 1 ;;
  esac
}

if is_read "$@"; then exec "$REAL_GH" "$@"; fi

# --- everything else must prove the identity, and FAIL CLOSED ----------------
ACTIVE=$("$REAL_GH" api user --jq .login 2>/dev/null)

if [ -z "$ACTIVE" ]; then
  cat >&2 <<MSG

  gh WRITE BLOCKED — could not determine the active GitHub account.

  This fails closed on purpose. An unverifiable identity is not permission to
  publish under the company name.

  Check with:  gh auth status
MSG
  exit 1
fi

if [ "$ACTIVE" != "$EXPECTED" ]; then
  cat >&2 <<MSG

  gh WRITE BLOCKED — wrong GitHub identity.

  Active account : $ACTIVE
  Required       : $EXPECTED

  Anything posted now would be public under "$ACTIVE" and is not undoable.
  On 2026-08-29 exactly this put two outreach comments under a personal
  account, on our two most valuable prospect threads.

  Fix:  gh auth switch --user $EXPECTED

MSG
  exit 1
fi

exec "$REAL_GH" "$@"
