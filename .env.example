# --- Server ---
PORT=3000

# --- Payment mode ---
# "none"  - no payment wall (marketplace-hosted builds: the marketplace bills)
# "x402"  - per-call USDC on Base via x402 middleware
PAYMENT_MODE=none

# x402 settings (only read when PAYMENT_MODE=x402)
# Address that receives USDC payouts. Use a FRESH wallet, never a main wallet.
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_PRICE_USD=0.02
# Facilitator that verifies/settles payments (see README for mainnet options)
X402_FACILITATOR_URL=

# Free tier: unpaid calls allowed per client IP before payment is required
FREE_CALLS_PER_IP=10

# --- Usage ledger ---
# Directory for the append-only usage/billing event log (a mounted volume in
# production). Defaults to ./data.
DATA_DIR=./data
# Bearer token protecting GET /stats (daily usage + revenue series). Leave
# empty to keep the endpoint dark.
STATS_TOKEN=

# --- Data providers ---
# Comma-separated Base mainnet RPC URLs, tried in order. Public endpoints work.
BASE_RPC_URLS=https://mainnet.base.org

# Optional. Etherscan v2 free key (no spend exposure) enables contract-verification
# checks and first-time-counterparty detection. Leave empty to degrade gracefully.
ETHERSCAN_API_KEY=
